# Groq API Key (used for Planner, Fact Grounder, Disagreement Scorer, Chairman)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (used as automatic fallback when Groq fails)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama Configuration (used for Council Member A and Council Member B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
